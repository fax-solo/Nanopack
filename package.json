{
  "name": "nanopack",
  "version": "1.0.10",
  "description": "Nano Pack",
  "author": {
    "name": "NanoPack Maintainers",
    "email": "maintainers@nanopack.app"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:all": "npm run build:main && npm run build:preload && npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:all": "npm run build:main && npm run build:preload && npm run check",
    "start": "npm run build:all && electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "tsx tests/run.ts",
    "download-vendor": "tsx scripts/download-vendor.ts",
    "install-vendor": "tsx scripts/install-all-vendor.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "7zip-min": "^3.0.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
